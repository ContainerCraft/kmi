# Rocky Linux 10 requires x86-64-v3 CPU features for package installation
# The libguestfs appliance is x86-64-v2, so customize operations fail
# Package installation and service enablement must be done via cloud-init userdata
# Only SELinux configuration is performed here (does not require executing guest binaries)
edit /etc/selinux/config:s/^SELINUX=*/SELINUX=permissive/
selinux-relabel
